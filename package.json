{
  "name": "midflow-ai",
  "version": "1.0.0",
  "description": "MIDFLOW AI — Multi-Hospital Operations, Resource Optimization, and Patient Appointment System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
